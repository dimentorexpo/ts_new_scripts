{
  "manifest_version": 3,
  "name": "Technical Support Master",
  "short_name": "TSM",
  "description": "Контекстное и вспомогательное меню с доп.функциями для ЛК пользователей. Включается дабл кликом ЛКМ или комб. клавиш ALT+0",
  "version": "2.0.29",
  "permissions": [
    "contextMenus",
    "clipboardWrite",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "*://skyeng.autofaq.ai/*",
    "*://*.skyeng.ru/*",
    "*://*.skyeng.tech/*"
  ],
  "background": {
    "service_worker": "app.js"
  },
  "action": {
    "default_icon": {
      "32": "/Icons/32.png"
    },
    "default_title": "TSM - Technical Support Master Personal Cabinet Multitool"
  },
"content_scripts": [
  {
    // Блок 1: Основной интерфейс (Autofaq + Общие сайты Skyeng)
    "js": ["content.js"],
    "css": ["/CSS/styles.css"],
    "matches": [
      "*://skyeng.autofaq.ai/*",
      "*://*.skyeng.ru/*", 
      "*://*.skyeng.tech/*"
    ],
    "run_at": "document_idle",
    "all_frames": true 
  },
  {
    // Блок 2: Специфичные модули для учителей/учеников
    // ВАЖНО: Проверь, пересекаются ли эти адреса с Блоком 1. 
    // Если да, лучше вынести уникальные JS сюда, а CSS оставить в одном месте или убрать отсюда, 
    // если styles.css уже загружен в Блоке 1.
    "js": [
      "/Modules/chats.js",
      "/Modules/exercises.js",
      "/Modules/lessoninfo.js",
      "/Modules/main.js",
      "/Modules/students.js",
      "/Modules/vocabulary.js"
    ],
    // Если styles.css нужен ТОЛЬКО здесь и не грузится сверху — оставь css поле.
    // Если он уже загружен в первом блоке для тех же доменов — удали строку "css" отсюда, 
    // чтобы не грузить двойной вес.
    "matches": [
      "*://vimbox.skyeng.ru/*",
      "*://new-teachers.skyeng.ru/*",
      "*://teachers.skyeng.ru/*",
      "*://student.skyeng.ru/*",
      "*://ttc.skyeng.ru/*",
      "*://teacher.skyeng.ru/*",
      "*://communications.skyeng.ru/*",
      "*://start.skyeng.ru/*"
    ],
    "run_at": "document_idle",
    "all_frames": true
  },
  {
     // Блок 3: React Cache (специфика multi-classroom)
     "js": ["/Modules/reacticache.js"],
     // Стили скорее всего уже подтянулись из блоков выше, но если нужны особые — оставь.
     "matches": [
       "*://vimbox.skyeng.ru/kids/english/teacher/multi-classroom/*"
     ],
     "run_at": "document_idle",
     "all_frames": true
  }
],
  
  "icons": {
    "16": "/Icons/16.png",
    "32": "/Icons/32.png",
    "48": "/Icons/48.png",
    "128": "/Icons/128.png"
  }
}